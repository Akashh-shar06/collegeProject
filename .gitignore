!/public/uploads/.htaccess
!/public/uploads/leave_docs/
!/public/uploads/leave_docs/.gitkeep
!/public/uploads/students/
!/public/uploads/students/.gitkeep

# Temporary / Scratch logs, test dumps, backups
/scratch/*.log
/scratch/*.txt
/scratch/*.json
/scratch/*cookie*

# General logs
*.log
